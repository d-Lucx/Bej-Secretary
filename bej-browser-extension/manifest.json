{
  "manifest_version": 3,
  "name": "Bej Web Notes",
  "version": "1.0.0",
  "description": "Manually preview and save selected webpage text to your local Bej vault.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8766/*"],
  "action": { "default_popup": "popup.html", "default_title": "Bej Web Notes" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:8766" }
}
